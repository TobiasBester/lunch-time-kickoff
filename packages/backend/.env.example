# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lunch_time_kickoff

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Football Data API
FOOTBALL_DATA_API_KEY=your_api_key_here
FOOTBALL_DATA_API_URL=https://api.football-data.org/v4

# Cache Configuration (in seconds)
CACHE_TTL_COMPETITIONS=604800  # 1 week
CACHE_TTL_SEASONS=86400         # 1 day
CACHE_TTL_TEAMS=86400           # 1 day
CACHE_TTL_MATCHES=3600          # 1 hour
